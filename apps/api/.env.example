# API server
PORT=4000
NODE_ENV=development

# LOCAL DEVELOPMENT USES A NEON DEV BRANCH — never point this at production.
# Neon gives you two strings: a pooled one for the app, a direct one for migrations.
# Prisma CLI (migrate/studio) reads DIRECT_URL from prisma.config.ts.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/applied?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/applied?sslmode=require"

# Generate a real value with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"

# Browser origin. No CORS middleware is needed because the browser calls /api
# on its own origin (Vite proxy / Vercel rewrite); this documents that origin.
CORS_ORIGIN="http://localhost:5173"

# Proxy hops Express trusts when finding a visitor's IP for rate limiting.
# Local or Vercel Services: 1. Add one per extra proxy hop.
TRUST_PROXY=1
