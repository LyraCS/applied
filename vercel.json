{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "framework": "express",
      "entrypoint": "apps/api/src/server.ts",
      "buildCommand": "npm run generate --workspace @applied/api"
    },
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build --workspace @applied/web",
      "outputDirectory": "apps/web/dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
